# Model
CUGA_MODEL=gpt-4o

# For OpenAI-compatible endpoints (LiteLLM, Ollama, vLLM, etc.)
# Leave blank for normal OpenAI.
CUGA_BASE_URL=
CUGA_API_KEY=

# Optional direct names accepted by CUGA's OpenAI configuration.
# The wrapper will populate these from CUGA_* values.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# CUGA configuration
CUGA_CONFIGURATIONS_DIR=
AGENT_SETTING_CONFIG=settings.openai.toml

# Skills
SKILLS_ROOT=cuga

# Optional MCP registry.
# Point this at a YAML registry if you want MCP/OpenAPI tools.
MCP_SERVERS_FILE=

# Optional observability
LANGFUSE_TRACING=false
OPENLIT=false
OTEL_EXPORTER_OTLP_ENDPOINT=
